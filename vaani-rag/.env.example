SARVAM_API_KEY=
# ==============================
# Pinecone
# ==============================

PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=vaani-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

GEMINI_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=vaani_rag

# ==============================
# Embeddings
# ==============================

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=openvino
EMBEDDING_DEVICE=GPU
EMBEDDING_MODEL_PATH=models/bge-m3-openvino
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=8192


# ==============================
# Dataset
# ==============================

LANGUAGES=en,hi,mr
MAX_ROWS_PER_LANGUAGE=1000000


# ==============================
# Chunking
# ==============================

CHUNKING_STRATEGY=adaptive


# ==============================
# Ingestion
# ==============================

DRY_RUN=true
UPLOAD_TO_PINECONE=false

CHECKPOINT_INTERVAL=1000
PINECONE_UPSERT_BATCH_SIZE=100
EMBED_UPLOAD_BATCH_SIZE=64

CONFIRM_LARGE_UPLOAD=false
