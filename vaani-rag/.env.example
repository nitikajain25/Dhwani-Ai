# Pinecone configuration
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=vaani-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local Embedding Model configuration
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16

# Supported languages (comma-separated)
LANGUAGES=en,hi,mr

# Dataset processing limits (safety configuration)
MAX_ROWS_PER_LANGUAGE=100

# Chunking strategy: original, sentence, fixed_overlap, semantic, adaptive
CHUNKING_STRATEGY=adaptive

# Dry run parameters
DRY_RUN=true
UPLOAD_TO_PINECONE=false

# Ingestion settings
CHECKPOINT_INTERVAL=1000
PINECONE_UPSERT_BATCH_SIZE=100

# Cost safety bypass parameter (requires true if processing > 100,000 vectors)
CONFIRM_LARGE_UPLOAD=false
